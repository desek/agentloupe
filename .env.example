# @agents-index Every variable name that compose passes to loupe through .env, with no value; copy to .env and fill in.
# Required. Make each value with: loupe gen-key
LOUPE_DATA_KEY=
LOUPE_ACCOUNT_KEY=
# Optional secrets. Remove the leading # and give a value to use one; an empty value is not valid.
# The bootstrap proxy token. Make the value with: loupe token generate
# LOUPE_BOOTSTRAP_TOKEN=
# One line per GitHub token; the part after the prefix is the label, for example LOUPE_GITHUB_TOKEN_PERSONAL.
# LOUPE_GITHUB_TOKEN_PERSONAL=
# LOUPE_SUMMARY_API_KEY=
# LOUPE_SUMMARY_OAUTH_TOKEN=
# LOUPE_ADMIN_TOKEN=
# Optional values that are not secret; unset uses the default.
# LOUPE_SUMMARY_MODEL=
# LOUPE_TZ=
# LOUPE_PUBLISH_AT=
# Seconds with no call before a session segment closes. Default 3600.
# LOUPE_IDLE_SECS=
# Seconds between two passes of the parser worker. Default 5.
# LOUPE_PARSE_INTERVAL_SECS=
# LOUPE_RAW_RETENTION_HOURS=
# LOUPE_SITE_TITLE=
# LOUPE_PUBLIC_PROJECTS=
# LOUPE_DAY_REVIEW=
# One line per subscription; monthly price in USD, for example LOUPE_SUBSCRIPTION_CLAUDE_MAX.
# LOUPE_SUBSCRIPTION_CLAUDE_MAX=
# Proxy values, not secret; unset uses the default. LOUPE_UPSTREAMS_FILE is the allowlist path.
# LOUPE_UPSTREAMS_FILE=
# LOUPE_CAPTURE_MAX_BYTES=
# LOUPE_CAPTURE_QUEUE=
# LOUPE_UPSTREAM_CONNECT_TIMEOUT_SECS=
# LOUPE_UPSTREAM_HEADERS_TIMEOUT_SECS=
